[Unit]
Description=resume-assistant: chat backend for sumanthreddy-de.github.io
After=network-online.target
Wants=network-online.target

[Service]
User=resume
Group=resume
WorkingDirectory=/opt/resume-assistant
EnvironmentFile=/etc/resume-assistant/env
ExecStart=/opt/resume-assistant/.venv/bin/uvicorn app:get_app --factory --host 127.0.0.1 --port 8100 --no-access-log
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=300M
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
